{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "openclaw/*"
      ]
    }
  },
  "include": [
    "openclaw",
    "scripts",
    "config.ts",
    "xiaoai-tools-plugin"
  ],
  "exclude": [
    "node_modules"
  ]
}
