# OpenClaw Gateway
OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_ENDPOINT=/v1/chat/completions
OPENCLAW_TOKEN=
OPENCLAW_MODEL=openclaw
OPENCLAW_AGENT_ID=xiaoai
OPENCLAW_SESSION_USER=xiaoai-bridge-family
OPENCLAW_SESSION_KEY=
OPENCLAW_TIMEOUT_MS=30000
OPENCLAW_TEMPERATURE=0.3
OPENCLAW_HISTORY_MAX_LENGTH=0

# XiaoAI bridge ports
OPEN_XIAOAI_SERVER_PORT=4399
OPEN_XIAOAI_DEBUG_PORT=4400
OPEN_XIAOAI_MEDIA_HOST=0.0.0.0
OPEN_XIAOAI_MEDIA_PORT=4401
OPEN_XIAOAI_MEDIA_ROOT=./media
OPEN_XIAOAI_MEDIA_PUBLIC_ORIGIN=

# Router
OPEN_XIAOAI_DEDUPE_WINDOW_MS=3000
OPEN_XIAOAI_ASSISTANT_KEYWORDS=请,问问小爱,小爱帮忙
OPEN_XIAOAI_HOME_KEYWORDS=打开,关闭,调到,设置,回充,扫地,空调,灯,窗帘,电视,加湿器,风扇,插座,净化器,米家,闹钟,提醒
OPEN_XIAOAI_HOME_PATTERNS=^(打开|关闭|开启|启动).*(灯|空调|窗帘|电视|风扇|插座|净化器|加湿器|扫地机器人)$;^(把)?(.+)?(调到|设置成).+$;^(让|叫).*(回充|回去充电)$;^.*(闹钟|提醒).*$
OPEN_XIAOAI_MEDIA_KEYWORDS=播放,http://,https://
OPEN_XIAOAI_MEDIA_PATTERNS=^播放\s+https?://.+\.(mp3|wav|m4a|aac|flac)(\?.*)?$;^https?://.+\.(mp3|wav|m4a|aac|flac)(\?.*)?$

# Speaker
OPEN_XIAOAI_TTS_BLOCKING=false
OPEN_XIAOAI_DEFAULT_PLAY_TIMEOUT=600000
OPEN_XIAOAI_ABORT_XIAOAI=true
OPEN_XIAOAI_ABORT_RECOVERY_MS=3000
